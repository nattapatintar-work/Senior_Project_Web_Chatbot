# ===========================================================================
# FoodFridgeGreen: environment template
# ===========================================================================
# This file is a TEMPLATE and is safe to commit: it contains no real secrets.
#
#   1. Copy it to ".env" in the repo root (no ".example" on the end)
#        Windows PowerShell:  Copy-Item .env.example .env
#        Git Bash / Linux:    cp .env.example .env
#   2. Fill in real values for the lines you need. Never commit .env (.gitignore blocks it).
#
# Real environment variables win over .env. Under systemd you can either keep a .env
# next to the code or set the same names with Environment= / EnvironmentFile=.
#
# Every variable below is READ BY THE CODE. Lines starting with "# NAME=" are optional:
# uncomment one only to override its default.
# ===========================================================================


# ===========================================================================
# Web chatbot (uvicorn api.app:app)  --  read by api/web_config.py
# ===========================================================================

# --- Anthropic API key -----------------------------------------------------
# OPTIONAL. Without it (or while it is still this placeholder) the app runs with no LLM:
#   - /confirm uses the keyword classifier instead of Claude Haiku
#   - /extract_bert uses the keyword extractor whenever the BERT model is unsure
# Real value goes in .env / the service environment only, never in this file.
# Treat it like a password; if it leaks, revoke it in the Anthropic console.
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# --- Extraction fallback model ---------------------------------------------
# OPTIONAL. Model id for the /extract_bert LLM fallback (nlp/extract_bert.py).
# Default: claude-sonnet-5 (api/web_config.py). Check the id is valid for your account
# with `python tools/check_llm_models.py`. If the API rejects it, text input falls back to
# the keyword extractor instead of failing.
# The /confirm classifier model (claude-haiku-4-5-20251001) is NOT configurable here.
# EXTRACTION_LLM_MODEL=

# --- BERT NER model folder --------------------------------------------------
# OPTIONAL. Folder with the exported WangchanBERTa NER model: config.json,
# label_config.json, model.safetensors, tokenizer.json, tokenizer_config.json.
# Default: models/bert_ner inside the repo. The weights are git-ignored, so copy them
# to the server by hand. If the folder or weights are missing, text input falls back to
# the keyword extractor and GET /health reports "bert": "unavailable".
# BERT_NER_MODEL_PATH=

# --- Sessions ---------------------------------------------------------------
# OPTIONAL. Idle seconds before an in-memory chat session is dropped. Default: 3600.
# Must be a number. Sessions live in one process, so run a single uvicorn worker.
# SESSION_TTL_SECONDS=3600

# --- CORS -------------------------------------------------------------------
# OPTIONAL. Comma-separated origins allowed to call the API from a browser, e.g.
# "http://localhost:8080,https://chat.example.com". Default: empty = same origin only,
# which is right when nginx serves the page and the API on one address.
# CORS_ORIGINS=

# --- Rate limiting behind a proxy -------------------------------------------
# OPTIONAL. Set to 1 when the API sits behind nginx / a load balancer that OVERWRITES
# X-Forwarded-For (docs/DEPLOY.md does). Default: 0. With 0 every visitor shares the
# proxy's address and therefore one rate-limit bucket (10 requests/minute for everybody).
# Leave it 0 when the API is exposed directly: the header would be client-controlled.
# TRUST_FORWARDED_FOR=0


# ===========================================================================
# LEGACY LINE OA bot (api/main.py, api/config.py)  --  NOT used by the web chatbot
# ===========================================================================
# api/config.py raises at import if the two LINE values are missing or still placeholders,
# but the web app never imports it. Skip this whole section for the web deployment.
# Where these come from: https://developers.line.biz/console/

# Channel access token: "Messaging API" tab -> "Channel access token (long-lived)".
# Treat it like a password.
LINE_CHANNEL_ACCESS_TOKEN=your_channel_access_token_here

# Channel secret: "Basic settings" tab (a DIFFERENT tab from the token above).
LINE_CHANNEL_SECRET=your_channel_secret_here

# OPTIONAL. Seconds to wait after the last LINE message before replying. Default: 2.5.
# DEBOUNCE_SECONDS=2.5
